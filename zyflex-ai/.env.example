# Server
PORT=8000
CACHE_TTL=300

# Location (defaults to Copenhagen)
CITY=København
WEATHER_LAT=55.6761
WEATHER_LON=12.5683
WEATHER_TZ=Europe/Copenhagen

# Google Places API (optional – Phase 1 demand agents)
# Systemet virker uden denne. Med key hentes rigtige virksomheder fra Google.
GOOGLE_PLACES_KEY=

# ── Persistent data storage (Phase 3) ───────────────────────────────────────
# Locally these default to zyflex-ai/data/*.jsonl — no setup needed.
#
# På Render (eller anden cloud-platform):
#   1. Opret en Render Disk og mount den på f.eks. /var/data
#   2. Sæt disse tre miljøvariabler til stier på den disk:
#
# FEEDBACK_DATA_PATH=/var/data/feedback.jsonl
# DEMAND_LOG_PATH=/var/data/demand_research.jsonl
# CONTRACTS_LOG_PATH=/var/data/contracts_log.jsonl
#
# Mapperne oprettes automatisk hvis de ikke eksisterer.
FEEDBACK_DATA_PATH=
DEMAND_LOG_PATH=
CONTRACTS_LOG_PATH=
